# Copia este archivo a .env y ajusta valores.
# PowerShell: Copy-Item .env.example .env

# TikTokApi session token (opcional pero recomendado)
ms_token=

# Browser para sesiones de TikTokApi: chromium | firefox | webkit
TIKTOK_BROWSER=chromium

# true/false para modo headless en TikTokApi
TIKTOK_HEADLESS=true

# Cantidad de comentarios publicos por video (0 = no extraer comentarios)
TIKTOK_COMMENTS_PER_VIDEO=0

# true/false para comentarios (puede diferir de TIKTOK_HEADLESS)
TIKTOK_COMMENTS_HEADLESS=false
